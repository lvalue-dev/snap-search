# ---- 이미지 (GitHub Actions가 GHCR로 push) ----
BACKEND_IMAGE=ghcr.io/lvalue-dev/snap-search:latest
FRONTEND_IMAGE=ghcr.io/lvalue-dev/snap-search-fe:latest

# ---- 공개 URL (Cloudflare Tunnel에 연결한 도메인) ----
PUBLIC_URL=https://www.toomuchoffside.site

# ---- MySQL ----
MYSQL_DATABASE=SNAP_SEARCH
MYSQL_USER=lvalue
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# ---- 외부 데이터 API (저장소에 커밋하지 말 것) ----
API_FOOTBALL_KEY=

# ---- Cloudflare Tunnel 토큰 (Zero Trust > Networks > Tunnels) ----
CLOUDFLARE_TUNNEL_TOKEN=
